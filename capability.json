{
  "schemaVersion": 1,
  "id": "ui",
  "package": "@nuxt4-layers/ui",
  "kind": "foundation",
  "description": "Reusable presentation primitives, semantic design tokens and accessibility-safe UI defaults.",
  "publicExports": [".", "./theme", "./tokens.css"],
